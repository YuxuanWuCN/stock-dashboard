# ==============================================================================
# Rainbow-FinGPTv2 个人大模型 API 配置文件模版 (.env.example)
#
# 使用指南：
# 1. 复制本文件并重命名为 .env （命令行运行: cp .env.example .env 或 手动复制重命名）
# 2. 填入你自己的 API Key 与 Base URL
# 3. 本文件 (.env) 已被 .gitignore 全局忽略，绝不会被 git 提交泄露
# ==============================================================================

# 你的个人 API Key（以 sk- 开头）
OPENAI_API_KEY=sk-your-personal-api-key-here

# 大模型兼容服务商 Base URL（支持任何兼容 OpenAI 协议的中转或官方接口）
# 常见推荐（请按个人喜好选择一行，去掉注释）：
# 1. DeepSeek 官方接口:
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 2. 硅基流动 SiliconFlow（注册送 14 元免费额度，支持标准 768 维嵌入模型）:
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 3. 阿里百炼 DashScope:
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 4. 其它 OpenAI 兼容中转站:
# OPENAI_BASE_URL=https://your-custom-proxy.com/v1

# 用于第一阶段提炼“机构博弈情绪与研报观点”的聊天模型（Chat Model）
# 推荐: deepseek-chat 或 Qwen/Qwen2.5-7B-Instruct 等
OPENAI_CHAT_MODEL=deepseek-chat

# 用于第二阶段生成 768 维特征向量的嵌入模型（Embedding Model）
# 推荐（标准 768 维）: BAAI/bge-base-zh-v1.5 或 text-embedding-3-small
OPENAI_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5

# 爬虫与调用控制参数
LLM_STAGE1_ENABLED=true
LLM_MAX_RETRIES=3
LLM_REQUEST_INTERVAL=0.5
