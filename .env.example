# ==============================================================================
# Rainbow-FinGPT v2 Environment Configuration Template
# ==============================================================================
# 复制此文件为 .env：
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# 或直接运行交互式配置向导：
#   python tools/setup_env.py
#
# 安全提示：.env 包含私密 API 密钥，已被 .gitignore 忽略，切勿提交至公开仓库！
# ==============================================================================

# ==============================================================================
# 1. 运行模式与离线演示 (Running Mode & Offline Fallback)
# ==============================================================================
# OFFLINE_MODE / DEMO_MODE:
#   true:  完全开启本地离线演示模式。无需任何 API Key，不请求外网，
#          直接利用 docs/data/kline/ 下 166 只核心标的预置历史行情与量化指标，
#          保证本地看板搜索、回测、因子展示 100% 零崩溃秒级渲染。
#   false: 默认模式。优先请求实时行情网络接口，接口异常时自动优雅降级为离线数据。
OFFLINE_MODE=false
DEMO_MODE=false

# ==============================================================================
# 2. 本地服务端口配置 (Local Service & Web Ports)
# ==============================================================================
# API_PORT: Flask 后端服务端口（默认 5000）
API_PORT=5000

# WEB_PORT: 前端静态 Web 看板端口（默认 8000）
WEB_PORT=8000

# CORS 允许源（逗号分隔）
CORS_ORIGINS=https://yuxuanwucn.github.io,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8001,http://localhost:8001

# ==============================================================================
# 3. 大模型供应商配置 (LLM Providers & Multi-Engine)
# ==============================================================================
# LLM_ENABLED: 是否启用 LLM 智能研报与因子打分（false 时使用纯数学规则）
LLM_ENABLED=true

# LLM_BACKEND: 首选大模型后端
# 可选值: "deepseek" | "dashscope" | "gemini" | "openai"
LLM_BACKEND=deepseek

# ---- [A] DeepSeek (官方推荐，综合性价比与金融语义挖掘最优) ----
# 官网申请: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# 本地密钥文件路径（可选，优先级低于 DEEPSEEK_API_KEY）
DEEPSEEK_API_KEY_FILE=

# ---- [B] 阿里 DashScope / 通义千问 (国内高速直连稳定备份) ----
# 官网申请: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-turbo

# ---- [C] Google Gemini (海外/学术高阶推理) ----
GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=https://uuapi.shop/v1
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY_FILE=

# ---- [D] OpenAI 兼容网关 (可选) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# 4. 专业金融量化数据源 (Quantitative Financial Data Feeds)
# ==============================================================================
# Tushare Pro Token (高校学生/机构认证因子与高频行情)
# 官网注册获取: https://tushare.pro/
TUSHARE_TOKEN=

# 华南师范大学 CSMAR / Wind 因子库严格模式 (true 时缺失日历直接阻断报错)
SCNU_CSMAR_STRICT=false

# ==============================================================================
# 5. LLM 研报挖掘与限流保护 (Pipeline Governance & Quotas)
# ==============================================================================
# 是否生成排行榜重点个股研究报告
LLM_REPORTS_ENABLED=true
# 每日自动生成报告的标的数量上限 (0 为仅在手动触发时调用)
LLM_REPORTS_TOP_K=0
# 若已有今日研报，是否跳过重复生成
LLM_REPORTS_SKIP_EXISTING=true

# 单次 API 调用最长超时（秒）
LLM_TIMEOUT_SECONDS=30
# 每日全管线调用次数硬顶限制（防止异常循环消耗预算）
LLM_DAILY_CALL_LIMIT=50
# 单次生成最大 Token 数
LLM_MAX_TOKENS=1200
# 语义情感分析采样条数
LLM_SENTIMENT_SAMPLE_K=8
# 是否开启 SCNU-RAG 知识检索增强
LLM_RAG_ENABLED=true

# ==============================================================================
# 6. GitHub 远程自选股自动同步 (Remote Watchlist Sync)
# ==============================================================================
# GITHUB_TOKEN: GitHub Personal Access Token (只需 repo contents 读写权限)
# GITHUB_REPO: 仓库路径，格式如 "yuxuanwucn/Rainbow_FinGPTv2"
# GITHUB_WATCHLIST_PATH: 仓库内自选股 CSV 相对路径
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_WATCHLIST_PATH=watchlist.csv
