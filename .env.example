# FinGPT 风格研究流程 + DeepSeek V4 Flash
LLM_ENABLED=true
LLM_BACKEND=deepseek

# 二选一：环境变量密钥优先；本地密钥文件必须保持 Git 忽略。
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=api-key.txt
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型由 FinGPT 适配器固定并校验为 deepseek-v4-flash，不允许环境变量切换。
# 主排行榜在详情和排名落盘后自动生成前 K 名报告；没有可用密钥时安全跳过。
LLM_REPORTS_ENABLED=true
LLM_REPORTS_TOP_K=0
LLM_REPORTS_SKIP_EXISTING=true

LLM_TIMEOUT_SECONDS=30
LLM_DAILY_CALL_LIMIT=50
LLM_MAX_TOKENS=1200
LLM_SENTIMENT_SAMPLE_K=8
LLM_RAG_ENABLED=true

# ---- v2.5 新自选股自动入库 GitHub ----
# GITHUB_TOKEN：GitHub PAT（只需仓库 contents 读写权限）
# GITHUB_REPO：仓库名 "owner/repo"
# GITHUB_WATCHLIST_PATH=watchlist.csv
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_WATCHLIST_PATH=watchlist.csv
